{
  "name": "en-place",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "bun run --cwd apps/backend dev",
    "check:typescript": "bun run --filter '*' typecheck",
    "check:swift": "xcodebuild -project apps/macos/EnPlace.xcodeproj -scheme EnPlace -configuration Debug build",
    "check": "bun run check:typescript && bun run check:swift",
    "db:up": "docker compose -f infra/compose.yaml up -d postgres",
    "db:down": "docker compose -f infra/compose.yaml down",
    "db:generate": "bun run --cwd apps/backend db:generate",
    "db:migrate": "bun run --cwd apps/backend db:migrate",
    "db:check": "bun run --cwd apps/backend db:check",
    "db:studio": "bun run --cwd apps/backend db:studio"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
