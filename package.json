{
  "name": "en-place",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/backend",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f infra/compose.yaml up -d --wait postgres && bun run --parallel 'dev:*'",
    "dev:backend": "bun run --env-file=../../.env --cwd apps/backend dev",
    "dev:web": "bun run --cwd apps/web dev",
    "api:generate": "bun run --env-file=../../.env --cwd apps/backend api:generate",
    "check:typescript": "bun run --filter '*' typecheck",
    "check": "bun run check:typescript",
    "test": "bun run --env-file=../../.env --cwd apps/backend test",
    "db:up": "docker compose -f infra/compose.yaml up -d postgres",
    "db:down": "docker compose -f infra/compose.yaml down",
    "db:generate": "bun run --bun --env-file=../../.env --cwd apps/backend db:generate",
    "db:migrate": "bun run --bun --env-file=../../.env --cwd apps/backend db:migrate",
    "db:check": "bun run --bun --env-file=../../.env --cwd apps/backend db:check",
    "db:studio": "bun run --bun --env-file=../../.env --cwd apps/backend db:studio"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
